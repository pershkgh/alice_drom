# Наружу открыт только навык: /alice/... → наш сервис, всё остальное — 404.
# Адрес и почта берутся из .env (Caddy подставит их сам).
#
# ВАЖНО про безопасность: Яндекс НЕ подписывает запросы к вебхуку, поэтому
# единственная защита — непубличный адрес вида /alice/<секрет>. Секрет лежит
# в .env (WEBHOOK_SECRET), инсталлер генерирует его сам.
# Префикс /alice срезается: навык получает /<секрет> и отвечает только на него.

{
	email {$EMAIL}
}

{$DOMAIN} {
	encode gzip

	# Yandex стучится на /alice/<секрет> — префикс срезаем, секрет остаётся
	handle_path /alice/* {
		reverse_proxy 127.0.0.1:8100
	}

	# Всё остальное не публикуем: MA, Navidrome и пульт остаются в локальной сети
	handle {
		respond "alice-music: публично доступен только вебхук навыка" 404
	}

	log {
		output stdout
		format console
	}
}
