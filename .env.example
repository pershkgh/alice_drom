# ─────────────────────────────────────────────────────────────────────────────
#  Домашняя музыка — настройки. Скопируйте в .env и заполните.
#  Всё, что ниже, можно ввести руками или пройти инсталлятор: ./install.sh
# ─────────────────────────────────────────────────────────────────────────────

# ── Домен и HTTPS ────────────────────────────────────────────────────────────
# Адрес, по которому Яндекс будет стучаться в навык. Домен должен уже
# указывать на этот сервер, а 80/443 — быть свободны (или используйте свой прокси).
DOMAIN=music.example.com
EMAIL=you@example.com

# ── Music Assistant ──────────────────────────────────────────────────────────
# Адрес API MA. Если MA на этом же сервере — оставьте как есть.
MA_URL=http://127.0.0.1:8095
# Токен: Music Assistant → Настройки → Профиль → «Долгоживущий токен» → Создать.
MA_TOKEN=

# Игрок (станция). Пусто = взять единственную доступную станцию.
PLAYER_NAME=

# Имя навыка — то, которое вы вписали в Яндекс.Диалогах и называете голосом.
# Нужно для приветствия и чтобы понимать «запусти навык <имя>, включи …».
SKILL_NAME=Домашняя музыка

# ── Безопасность вебхука ────────────────────────────────────────────────────
# Секрет в адресе вебхука: Яндекс не подписывает запросы, поэтому публичный путь
# /alice открыл бы управление колонкой любому. Инсталлер генерирует сам.
# Смена секрета = новый адрес, его надо заново вписать в Яндекс.Диалоги.
WEBHOOK_SECRET=

# ── Доступ к навыку ──────────────────────────────────────────────────────────
# Навык должен быть ОПУБЛИКОВАН (в черновике Яндекс не запускает воспроизведение).
# Опубликованный навык может запустить любой пользователь Алисы, поэтому укажите
# свой user_id — тогда чужие получат отказ.
# Как узнать: скажите колонке любую команду и выполните
#   docker compose logs skill | grep user_id
OWNER_USER_ID=

# Уже необязательно: id навыка из Диалогов (доп. проверка session.skill_id).
SKILL_ID=

# ── Библиотека (для диагностики) ────────────────────────────────────────────
# Например https://music.example.com — тогда ./doctor.sh проверит, что Navidrome
# доступен. Если не задан, проверка пропускается (Navidrome может быть на NAS).
NAVIDROME_URL=

# ── Наш API (пульт для Windows, диагностика) ─────────────────────────────────
# Закрывает /api/* . Сгенерируйте: openssl rand -hex 24
API_TOKEN=

# ── Прочее ───────────────────────────────────────────────────────────────────
TZ=Europe/Moscow
LOG_LEVEL=INFO

# Сколько секунд навык удерживает сессию Алисы (не трогайте без нужды)
SESSION_HOLD=1

# Держать громкость неизменной: после «далее»/«назад»/«паузы» навык возвращает
# последний заданный уровень (станция на громкости 1–3 иногда «прибавляет» сама).
VOLUME_LOCK=1
